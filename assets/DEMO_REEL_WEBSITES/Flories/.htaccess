# ============================================================
# .htaccess — Root-level rules for Flories
# Place this in your public_html/flories/ folder
# ============================================================

# Block direct access to sensitive PHP files
<FilesMatch "^db\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent directory listing
Options -Indexes

# Allow CORS for API folder (handled per-file in PHP too)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
